# Copy this file to .env before running the project
# Example:
# cp .env.example .env

# App
APP_NAME=AI Stack
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# Backend
HOST=127.0.0.1
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# Local storage / runtime
DATA_DIR=./data
CACHE_DIR=./data/cache
MEMORY_DIR=./data/memory
LOG_DIR=./logs

# Optional database
DATABASE_URL=sqlite:///./data/app.db

# Optional frontend
FRONTEND_URL=http://localhost:3000

# Optional future integrations
OPENAI_API_KEY=
GITHUB_TOKEN=